## Local development defaults
NODE_ENV=development
PORT=3002
API_PORT=3002
UNIFIED_WS=1

# MySQL (local)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=game

# JWT (change in your local .env)
JWT_SECRET=change_me_dev

## Production example (Atspace)
# Set these in your deployment environment or .env.production (do NOT commit real secrets)
# NODE_ENV=production
# PORT=3002
# API_PORT=3002
# UNIFIED_WS=1
# MYSQL_HOST=pdb1007.atspace.me
# MYSQL_PORT=3306
# MYSQL_USER=2290917_neongames
# MYSQL_PASSWORD=YOUR_STRONG_PASSWORD
# MYSQL_DB=2290917_neongames
# MYSQL_SSL=1
# MYSQL_SSL_REJECT_UNAUTH=0
# JWT_SECRET=change_me_prod
